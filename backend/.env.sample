# Copy to backend/.env and fill in real values. .env is git-ignored.
# Only needed when running uvicorn locally; the Docker service passes these in
# through docker-compose.yml instead.
#
# Variable names match what infra/locals.tf injects into the deployed Lambda,
# so the same settings object serves both.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_NAME=acme_incidents
POSTGRES_USER=acme
POSTGRES_PASS=<copy from the POSTGRES_PASSWORD in the repository root .env>

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=<set-this-locally>
ACCESS_TOKEN_TTL_MINUTES=60

# Origins allowed to call the API. Never "*" in a deployed environment.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

IS_LOCAL=true
LOG_LEVEL=INFO
